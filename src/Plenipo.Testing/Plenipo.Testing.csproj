<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The conformance kit: the platform publishes its tests, the products execute them.
    A product's tests/<Product>.IntegrationTests references this package and derives four
    classes from it — the host fixture, the spine invariants, the manifest and tenancy
    conformance, and the golden-eval runner — instead of copying the sample suite's files.
    The kit ships at the platform version, so upgrading PlenipoVersion upgrades the invariants.
    See docs/TESTING_CONTRACT.md.
  -->
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <!-- A library of test base classes, not a test project: `dotnet test Plenipo.slnx` must skip it
         rather than try to host it (it references xunit but has no test runner of its own). -->
    <IsTestProject>false</IsTestProject>
    <PackageId>Plenipo.Testing</PackageId>
    <Description>Conformance kit for products built on Plenipo — the Testcontainers host fixture, the AG-UI stream parser, the golden-eval runner, and the platform's spine, manifest and tenancy invariants as executable xunit tests.</Description>
    <!-- CA1707: the kit's test methods are named as behaviour statements with underscores
         (Approving_a_parked_write_executes_it), the convention every suite on the fleet reads. -->
    <NoWarn>$(NoWarn);CA1707</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <!-- Testcontainers 4.15+ pins the first patched SSH.NET (GHSA-q939-rpr3-3284). Products get the
         floor transitively through this package, so an advisory is fixed once, here. -->
    <PackageReference Include="Testcontainers.PostgreSql" />
    <PackageReference Include="xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Plenipo.Application\Plenipo.Application.csproj" />
    <ProjectReference Include="..\Plenipo.Infrastructure\Plenipo.Infrastructure.csproj" />
    <ProjectReference Include="..\Plenipo.Modules.Sdk\Plenipo.Modules.Sdk.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The family packs the repository README into every package (Directory.Build.targets), so the
         kit's own README.md stays a source-tree document rather than a second package readme. -->
    <None Include="buildTransitive\Plenipo.Testing.targets" Pack="true" PackagePath="buildTransitive/" />
  </ItemGroup>

</Project>
