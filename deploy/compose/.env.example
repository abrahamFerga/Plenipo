# Copy to .env and edit. The .env file is your deployment's identity — never commit it.

# REQUIRED — generate independent values: openssl rand -hex 24
POSTGRES_PASSWORD=
AUDIT_POSTGRES_PASSWORD=

# Production authentication (both values are mandatory together).
AUTH_AUTHORITY=https://your-tenant.ciamlogin.com/your-tenant-id/v2.0
AUTH_AUDIENCE=your-api-application-id

# Image + port
#PLENIPO_IMAGE=ghcr.io/your-org/plenipo-sample:0.1.0   # pin a tag; default builds from source
#PLENIPO_PORT=8080
#PLENIPO_BIND_ADDRESS=127.0.0.1

# Environment: Development = keyless demo (Mock AI, X-Dev-* header auth).
# Production requires configuring a real identity provider first.
#PLENIPO_ENVIRONMENT=Production

# Chat deployment default stays keyless (Mock, managed-identity AzureOpenAI, or Ollama).
# Configure OpenAI/Anthropic and their live model catalogs per tenant in Admin → AI Settings.
#EMBEDDING_PROVIDER=OpenAI
#RAG_API_KEY=sk-...          # Optional deployment credential for OpenAI embeddings only

# Tenants switch provider/model/key at RUNTIME from the admin console (AI Settings) —
# the key is stored write-only in the secret vault, not in this file.

# Optional Azure augmentation for application-level agent guardrails. Plenipo prompt-attack detection
# and deterministic sensitive-data handling work without it. Configure AzureContentSafety when tenants
# also need Azure Prompt Shields and harmful-content categories. The key belongs to the deployment
# safety plane, not a tenant's model connection. Prefer managed identity on Azure.
#AGENT_SECURITY_PROVIDER=AzureContentSafety
#AGENT_SECURITY_ENDPOINT=https://your-safety-resource.cognitiveservices.azure.com
#AGENT_SECURITY_API_KEY=

# Optional deploy-time extras (configured via Ai__/Mcp__ env vars or an appsettings overlay):
#   MCP tool servers:  Mcp__Servers__0__Name=github  Mcp__Servers__0__Transport=Stdio
#                      Mcp__Servers__0__Command=npx  Mcp__Servers__0__Arguments__0=-y ...
#   Secret storage:    Secrets__Provider=AzureKeyVault + Secrets__KeyVaultUri=... (default: DataProtection)
# See docs/CONFIGURATION.md for the full reference.
