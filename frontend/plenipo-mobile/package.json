{
  "name": "@plenipo/mobile",
  "version": "0.1.0-alpha",
  "description": "Server-driven React Native shell for Plenipo — renders a product's modules, tabs, and chat from the platform manifest, with no per-product mobile code.",
  "license": "MIT",
  "homepage": "https://github.com/abrahamFerga/Plenipo/tree/main/frontend/plenipo-mobile#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abrahamFerga/Plenipo.git",
    "directory": "frontend/plenipo-mobile"
  },
  "bugs": "https://github.com/abrahamFerga/Plenipo/issues",
  "type": "module",
  "//ships-source": "React Native libraries consumed by Expo apps ship TypeScript: Metro runs every dependency through babel-preset-expo, which handles TS and JSX. That removes a build step, a dist/ that can go stale, and the CJS/ESM dual-package problem — at the cost of requiring an Expo-flavoured Metro, which is this package's target anyway.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./expo": "./src/expo/index.ts"
  },
  "files": [
    "src"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "jest"
  },
  "dependencies": {
    "@plenipo/client": "workspace:*"
  },
  "peerDependencies": {
    "@react-navigation/bottom-tabs": ">=7",
    "@react-navigation/native": ">=7",
    "@react-navigation/native-stack": ">=7",
    "@tanstack/react-query": ">=5",
    "expo": ">=54",
    "react": ">=18",
    "react-native": ">=0.76",
    "react-native-safe-area-context": ">=4",
    "react-native-screens": ">=4",
    "react-native-svg": ">=15"
  },
  "//optional-peers": "Only the @plenipo/mobile/expo adapters import these. The core takes storage, push, and locale as injected adapters, so an app that supplies its own — or wants none — never installs them.",
  "peerDependenciesMeta": {
    "expo-application": { "optional": true },
    "expo-device": { "optional": true },
    "expo-localization": { "optional": true },
    "expo-notifications": { "optional": true },
    "expo-secure-store": { "optional": true }
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@react-navigation/bottom-tabs": "^7.3.14",
    "@react-navigation/native": "^7.1.9",
    "@react-navigation/native-stack": "^7.3.13",
    "@tanstack/react-query": "^5.59.16",
    "@testing-library/react-native": "^13.2.0",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.17",
    "eslint": "^9.13.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "expo": "~57.0.9",
    "expo-application": "~57.0.2",
    "expo-device": "~57.0.1",
    "expo-localization": "~57.0.1",
    "expo-notifications": "~57.0.8",
    "expo-secure-store": "~57.0.1",
    "globals": "^17.7.0",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.3",
    "react": "19.2.8",
    "react-native": "0.86.2",
    "react-native-safe-area-context": "~5.8.0",
    "react-native-screens": "~4.26.2",
    "react-native-svg": "~15.15.5",
    "react-test-renderer": "19.2.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.64.0"
  }
}
